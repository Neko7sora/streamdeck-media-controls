{
  "author": "Neko7sora",
  "id": "dev.n7s.icue-widget",
  "name": "Edge Media Deck",
  "description": "Now playing, seeking, player selection and Windows audio controls for CORSAIR XENEON EDGE, with an authenticated local bridge.",
  "version": "1.0.0",
  "preview_icon": "resources/icon.png",
  "min_app_version": "5.52",
  "min_framework_version": "1.9.0",
  "os": [
    { "platform": "windows" }
  ],
  "supported_devices": [
    { "type": "dashboard_lcd" }
  ],
  "interactive": true,
  "required_plugins": [
    "widgetbuilder.mediadataprovider:Media:1.1"
  ],
  "permissions": [
    { "type": "url", "domain": "127.0.0.1", "port": 39762 },
    { "type": "self-signed-certificate", "domain": "127.0.0.1" }
  ]
}
