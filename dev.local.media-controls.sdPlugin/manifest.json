{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "dev.local.media-controls",
  "Name": "Media Controls",
  "Category": "Media Controls",
  "Author": "Local Developer",
  "Description": "Windows and Chrome metadata, album artwork, playback timeline, media and volume control.",
  "Version": "0.4.3.0",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "Nodejs": {
    "Version": "24"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "CodePath": "bin/plugin.js",
  "Icon": "imgs/plugin-icon",
  "CategoryIcon": "imgs/category-icon",
  "Actions": [
    {
      "Name": "Play / Pause",
      "UUID": "dev.local.media-controls.play-pause",
      "Icon": "imgs/actions/play-pause-icon",
      "States": [
        {
          "Image": "imgs/actions/play-pause",
          "ShowTitle": false
        }
      ],
      "Tooltip": "Toggle playback",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html"
    },
    {
      "Name": "Previous Track",
      "UUID": "dev.local.media-controls.previous",
      "Icon": "imgs/actions/previous-icon",
      "States": [
        {
          "Image": "imgs/actions/previous",
          "ShowTitle": false
        }
      ],
      "Tooltip": "Skip to the previous track",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html"
    },
    {
      "Name": "Next Track",
      "UUID": "dev.local.media-controls.next",
      "Icon": "imgs/actions/next-icon",
      "States": [
        {
          "Image": "imgs/actions/next",
          "ShowTitle": false
        }
      ],
      "Tooltip": "Skip to the next track",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html"
    },
    {
      "Name": "Stop",
      "UUID": "dev.local.media-controls.stop",
      "Icon": "imgs/actions/stop-icon",
      "States": [
        {
          "Image": "imgs/actions/stop",
          "ShowTitle": false
        }
      ],
      "Tooltip": "Stop playback",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html"
    },
    {
      "Name": "Toggle Mute",
      "UUID": "dev.local.media-controls.mute",
      "Icon": "imgs/actions/mute-icon",
      "States": [
        {
          "Image": "imgs/actions/mute",
          "ShowTitle": false
        }
      ],
      "Tooltip": "Toggle selected Core Audio target mute",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html"
    },
    {
      "Name": "Volume Up",
      "UUID": "dev.local.media-controls.volume-up",
      "Icon": "imgs/actions/volume-up-icon",
      "States": [
        {
          "Image": "imgs/actions/volume-up",
          "ShowTitle": false
        }
      ],
      "Tooltip": "Increase selected Core Audio target volume",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html"
    },
    {
      "Name": "Volume Down",
      "UUID": "dev.local.media-controls.volume-down",
      "Icon": "imgs/actions/volume-down-icon",
      "States": [
        {
          "Image": "imgs/actions/volume-down",
          "ShowTitle": false
        }
      ],
      "Tooltip": "Decrease selected Core Audio target volume",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html"
    },
    {
      "Name": "Volume Dial",
      "UUID": "dev.local.media-controls.volume-dial",
      "Icon": "imgs/actions/volume-dial-icon",
      "States": [
        {
          "Image": "imgs/actions/volume-dial",
          "ShowTitle": false
        }
      ],
      "Tooltip": "Rotate for volume, press for mute",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "$B1",
        "TriggerDescription": {
          "Rotate": "Adjust volume",
          "Push": "Toggle mute"
        }
      },
      "PropertyInspectorPath": "ui/settings.html"
    },
    {
      "Name": "Now Playing (Artwork)",
      "UUID": "dev.local.media-controls.now-playing",
      "Icon": "imgs/actions/play-pause-icon",
      "States": [
        {
          "Image": "imgs/actions/play-pause",
          "ShowTitle": false
        }
      ],
      "Tooltip": "Shows artwork and title; press to toggle playback",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/settings.html"
    },
    {
      "Name": "Now Playing +",
      "UUID": "dev.local.media-controls.now-playing-dial",
      "Icon": "imgs/actions/play-pause-icon",
      "States": [
        {
          "Image": "imgs/actions/play-pause",
          "ShowTitle": false
        }
      ],
      "Tooltip": "Shows live position and duration; rotate to seek, press play/pause (volume mode in settings)",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/now-playing.json",
        "TriggerDescription": {
          "Rotate": "Seek backward / forward (or volume in settings)",
          "Push": "Play / Pause",
          "Touch": "Tap progress to seek; hold to change session"
        }
      },
      "PropertyInspectorPath": "ui/settings.html"
    }
  ]
}